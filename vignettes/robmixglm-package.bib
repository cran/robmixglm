@article{Aitkin1996,
	abstract = {This paper presents an EM algorithm for maximum likelihood estimation in generalized linear models with overdispersion. The algorithm is initially derived as a form of Gaussian quadrature assuming a normal mixing distribution, but with only slight variation it can be used for a completely unknown mixing distribution, giving a straightforward method for the fully non-parametric ML estimation of this distribution. This is of value because the ML estimates of the GLM parameters may be sensitive to the specification of a parametric form for the mixing distribution. A listing of a GLIM4 algorithm for fitting the overdispersed binomial logit model is given in an appendix. A simple method is given for obtaining correct standard errors for parameter estimates when using the EM algorithm. Several examples are discussed.},
	author = {Aitkin, Murray},
	date-added = {2018-05-11 00:49:54 +0000},
	date-modified = {2020-10-31 21:44:56 +1100},
	doi = {10.1007/BF00140869},
	file = {:Volumes/Ken Main/kjbeath/Documents/Mendeley Desktop/Aitkin - 1996 - A general maximum likelihood analysis of overdispersion in generalized linear models.pdf:pdf},
	journal = {Statistics and Computing},
	keywords = {em algorithm,mixture model,overdispersion,random effects glm},
	pages = {251--262},
	title = {{A general maximum likelihood analysis of overdispersion in generalized linear models}},
	volume = {6},
	year = {1996},
	Bdsk-Url-1 = {https://doi.org/10.1007/BF00140869}}
